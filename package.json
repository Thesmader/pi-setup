{
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "dependencies": {
    "@earendil-works/pi-ai": "^0.84.1",
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@earendil-works/pi-tui": "^0.84.1",
    "acorn": "^8.17.0",
    "typebox": "^1.3.6"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "prettier": "^3.9.5",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "check": "tsc --noEmit && pnpm -r --if-present run check",
    "format": "prettier --write \"extensions/**/*.{ts,cjs}\" \"extensions/**/package.json\" \"*.json\"",
    "format:check": "prettier --check \"extensions/**/*.{ts,cjs}\" \"extensions/**/package.json\" \"*.json\"",
    "test": "node --test --experimental-strip-types extensions/shared/*.test.ts extensions/workflows/*.test.ts && pnpm -r --if-present run test"
  }
}
